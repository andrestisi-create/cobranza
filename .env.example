# Cadena de conexión a PostgreSQL.
# Desarrollo: tu base local o en la nube (Neon, etc.).
# Producción (Coolify): usar el connection string interno del servicio PostgreSQL.
DATABASE_URL="postgresql://usuario:password@localhost:5432/cobranza?schema=public"

# Secreto para firmar las sesiones de Auth.js.
# Generar con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# URL pública de la aplicación.
# En producción: https://cobranza.ifabriano.cl
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
